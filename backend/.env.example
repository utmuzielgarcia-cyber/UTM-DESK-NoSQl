# Copia este archivo como .env y llena los valores reales. Nunca subas .env a git.

# Cadena de conexión de MongoDB Atlas (Database > Connect > Drivers)
MONGODB_URI=mongodb+srv://usuario:password@cluster0.xxxxx.mongodb.net/?retryWrites=true&w=majority
MONGODB_DB=utm_desk

# Secreto para firmar los JWT (usa una cadena larga y aleatoria)
JWT_SECRET=cambia-esto-por-una-cadena-larga-y-aleatoria
JWT_EXPIRES_IN=8h

# Puerto local y origen permitido del frontend (CORS)
PORT=3000
FRONTEND_URL=http://localhost:5173

# Contraseña que usa el seed para los usuarios de prueba
SEED_PASSWORD=UtmDesk2026!
